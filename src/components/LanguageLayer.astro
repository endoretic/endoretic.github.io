---
/*
 * The hidden language switch.
 *
 * This is an easter egg, so it is not a language menu in a corner. The trigger
 * is the decorative interval mark that already sits in the footer: identical to
 * the eye, unlabelled on the page, and a real button underneath with a real
 * accessible name. Hidden from the eye is the intent; hidden from assistive
 * technology or the keyboard would just be broken.
 *
 * Everything the layer needs — catalog, font, transformed markup — arrives only
 * after that button is used, or after `?layer=hymmnos` is requested directly.
 * A visitor who never finds it downloads none of it.
 *
 * The panel itself stays in the interface language on purpose. Its heading and
 * hint follow the layer, because they are atmosphere; the two option labels
 * never do, because they are the way back out.
 */

import NotationMotif from "./NotationMotif.astro";
import {
  DEFAULT_LOCALE,
  LAYER_LOCALE,
  LOCALE_PARAM,
  key,
  t,
} from "../lib/i18n";

interface Props {
  /* Any stable string, so the trigger keeps one glyph across builds. */
  seed?: string;
}

const { seed = "language-layer" } = Astro.props;
---

{/*
  * The marker is `data-language-switch`, not `data-language-layer`: that second
  * name belongs to the flag the script sets on the document element while the
  * layer is on. Sharing one name would put the attribute on both <html> and
  * this div, and <html> comes first in document order, so the lookup would
  * return the document, the real switch would never be revealed, and a reader
  * in Hymmnos would have no way back to English.
  */}
<div
  class="language-layer"
  data-language-switch
  data-default-locale={DEFAULT_LOCALE}
  data-layer-locale={LAYER_LOCALE}
  data-locale-param={LOCALE_PARAM}
  data-catalog-url="/locales/hymmnos.json"
  data-translit-label={t("layer.translit")}
  hidden
>
  <button
    type="button"
    class="language-layer__trigger"
    aria-label={t("layer.title")}
    aria-expanded="false"
    aria-controls="language-layer-panel"
    data-language-trigger
  >
    <NotationMotif seed={seed} />
  </button>

  <div
    class="language-layer__panel"
    id="language-layer-panel"
    role="group"
    aria-label={t("layer.title")}
    hidden
    data-language-panel
  >
    <div class="language-layer__bar">
      <p class="language-layer__heading" {...key("layer.title")}>
        {t("layer.title")}
      </p>
      {/*
        * Escape and an outside click both close the panel, but neither is
        * discoverable on a touch screen, so the panel carries its own way out.
        */}
      <button
        type="button"
        class="language-layer__close"
        lang="en"
        data-language-close
      >
        {t("layer.close")}
      </button>
    </div>

    <ul class="language-layer__options">
      <li>
        <button
          type="button"
          class="language-layer__option"
          aria-pressed="true"
          data-language-option={DEFAULT_LOCALE}
        >
          <span class="language-layer__bullet" aria-hidden="true">●</span>
          <span lang="en">{t("layer.english")}</span>
        </button>
      </li>
      <li>
        <button
          type="button"
          class="language-layer__option"
          aria-pressed="false"
          data-language-option={LAYER_LOCALE}
        >
          <span class="language-layer__bullet" aria-hidden="true">○</span>
          <span lang="en">{t("layer.hymmnos")}</span>
        </button>
      </li>
    </ul>

    <p class="language-layer__hint" {...key("layer.hint")}>{t("layer.hint")}</p>
  </div>
</div>

<script>
  import { projectBodyKey } from "../lib/prose-key.mjs";
  import { hymmnosTranscription, renderHymmnos } from "../lib/hymmnos-text.mjs";

  /*
   * Applies a language catalog over already-rendered English, and draws the
   * Hymmnos entries in tower glyphs.
   *
   * The catalog stores Latin transcription, not invented private-use
   * codepoints: Hymmnos is twenty-six letters written left to right, and the
   * font maps those letters to glyphs. So the text stays real text — selectable,
   * searchable, copyable — and only the typeface changes. Language layer and
   * script layer are two axes, never one. See docs/HYMMNOS_LAYER.md.
   */
  interface DecodeEntry {
    line: HTMLElement;
    from: string;
    to: string;
    text: string;
    glyphs: boolean;
  }

  /*
   * Module scope, because the document outlives the page. With the client
   * router a navigation swaps the body and leaves this module loaded, so the
   * things that must survive a swap — the fetched catalog and this visit's
   * selected layer — live out here, while everything bound to nodes that are
   * about to be replaced is torn down and rebuilt per page.
   */
  let catalog: Record<string, string> | null = null;
  let bindings: AbortController | null = null;
  let activeLayer: string | null = null;

  /* Discard the old saved preference; a fresh document starts in English. */
  try {
    window.localStorage.removeItem("endoretic:language-layer");
  } catch {
    /* Blocked storage does not affect this in-memory easter egg. */
  }

  const setup = (): void => {
    /*
     * One controller per page. Aborting it drops every listener belonging to
     * the page being left — including the two on `document`, which outlives the
     * swap and would otherwise collect another pair on every navigation.
     */
    bindings?.abort();
    bindings = new AbortController();
    const { signal } = bindings;

    const root = document.querySelector<HTMLElement>("[data-language-switch]");
    const trigger = document.querySelector<HTMLButtonElement>(
      "[data-language-trigger]",
    );
    const panel = document.querySelector<HTMLElement>("[data-language-panel]");

    if (!root || !trigger || !panel) return;

    const defaultLocale = root.dataset.defaultLocale ?? "en";
    const layerLocale = root.dataset.layerLocale ?? "x-hymmnos";
    const localeParam = root.dataset.localeParam ?? "layer";
    const catalogUrl = root.dataset.catalogUrl ?? "/locales/hymmnos.json";
    /*
     * The gloss label stays in the interface language even inside the layer. A
     * gloss whose own label needs glossing helps nobody.
     */
    const translitLabel = root.dataset.translitLabel ?? "Transliteration";

    /*
     * Interface strings carry their catalog key in `data-i18n`. Content
     * strings — a project summary, whose English is frontmatter rather than
     * catalog — carry theirs in `data-i18n-content`, because the English of an
     * interface key is checked against the catalog byte for byte and a summary
     * has no catalog English to be checked against. Once the layer is on, both
     * are replaced identically.
     */
    /*
     * Body prose arrives from markdown with nothing to key it by, so each
     * paragraph is named here from its own text. Doing it before the targets
     * are collected lets everything downstream treat prose and markup the same.
     *
     * A paragraph already carrying a key is left alone: on a second pass its
     * text content is the glyph tier, and rehashing that would name a
     * paragraph that does not exist.
     */
    for (const prose of document.querySelectorAll<HTMLElement>(
      "[data-i18n-prose]",
    )) {
      const id = prose.dataset.i18nProse;
      if (!id) continue;

      for (const paragraph of prose.querySelectorAll<HTMLElement>(":scope > p")) {
        if (paragraph.dataset.i18nContent !== undefined) continue;

        const text = paragraph.textContent ?? "";
        if (text.trim() === "") continue;

        paragraph.dataset.i18nContent = projectBodyKey(id, text);
        /* Prose sets its gloss below the line rather than lifting it out. */
        paragraph.dataset.i18nFlow = "";
      }
    }

    const targets = Array.from(
      document.querySelectorAll<HTMLElement>("[data-i18n], [data-i18n-content]"),
    );

    const catalogKey = (node: HTMLElement): string =>
      node.dataset.i18n ?? node.dataset.i18nContent ?? "";

    /*
     * The rendered English is captured before anything is replaced. Restoring
     * from the page is exact and free, which is why only the Hymmnos catalog is
     * ever fetched.
     *
     * A persisted element arrives already translated: the recording keeps
     * playing across a navigation, so its label survives the swap with the
     * tiers still built. Its English has to be read back off the meaning tier,
     * because its text content is now glyph transcription and reading that
     * would make the way back out of the layer restore nonsense.
     */
    const english = new Map<HTMLElement, string>(
      targets.map((node) => {
        const meaning = node.querySelector<HTMLElement>(".hy-meaning");
        return [node, (meaning ?? node).textContent ?? ""];
      }),
    );

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let locale = defaultLocale;
    let requestedLocale = defaultLocale;
    let request = 0;
    let animation = 0;
    let restoreTimer = 0;
    signal.addEventListener("abort", () => {
      window.cancelAnimationFrame(animation);
      window.clearTimeout(restoreTimer);
    }, { once: true });

    /*
     * Structure, not just text. The glyph line is hidden from assistive
     * technology and the English original is kept as the element's accessible
     * text, so switching the layer never changes what a screen reader reads or
     * what in-page search can find.
     */
    const build = (
      node: HTMLElement,
      /* What the glyph line shows right now — the departing text mid-decode. */
      lineText: string,
      lineLocale: string,
      /* What the gloss tier always shows: the settled Hymmnos transcription. */
      hymmnos: string,
    ): HTMLElement => {
      const flow = node.hasAttribute("data-i18n-flow") && !node.closest("a, button");
      const wrap = document.createElement(flow ? "button" : "span");
      wrap.className = flow ? "hy hy--flow" : "hy";
      if (wrap instanceof HTMLButtonElement) {
        wrap.type = "button";
        wrap.setAttribute("aria-expanded", "false");
        let hoverTimer = 0;
        wrap.addEventListener("pointerenter", (event) => {
          if (event.pointerType === "touch") return;
          hoverTimer = window.setTimeout(() => {
            wrap.setAttribute("aria-expanded", "true");
          }, 600);
        });
        wrap.addEventListener("pointerleave", () => {
          window.clearTimeout(hoverTimer);
          if (!wrap.matches(":focus-visible")) wrap.setAttribute("aria-expanded", "false");
        });
        wrap.addEventListener("focus", () => {
          if (wrap.matches(":focus-visible")) wrap.setAttribute("aria-expanded", "true");
        });
        wrap.addEventListener("blur", () => {
          window.clearTimeout(hoverTimer);
          wrap.setAttribute("aria-expanded", "false");
        });
        wrap.addEventListener("click", () => {
          window.clearTimeout(hoverTimer);
          wrap.setAttribute("aria-expanded", String(wrap.getAttribute("aria-expanded") !== "true"));
        });
      }

      const line = document.createElement("span");
      line.className = "hy-line";
      line.lang = lineLocale;
      line.setAttribute("aria-hidden", "true");
      if (lineLocale === layerLocale) renderHymmnos(line, lineText);
      else line.textContent = lineText;

      const translit = document.createElement("span");
      translit.className = "hy-translit";
      translit.setAttribute("aria-hidden", "true");
      translit.dataset.label = translitLabel;
      translit.textContent = hymmnosTranscription(hymmnos);

      /*
       * Never drawn. This is the element's accessible text and what in-page
       * search matches, which is what keeps the layer from hiding the site
       * from assistive technology.
       */
      const meaning = document.createElement("span");
      meaning.className = "hy-meaning";
      meaning.lang = "en";
      meaning.textContent = english.get(node) ?? "";

      wrap.append(line, translit, meaning);
      node.replaceChildren(wrap);

      return line;
    };

    const restore = (): void => {
      for (const node of targets) {
        node.replaceChildren(document.createTextNode(english.get(node) ?? ""));
      }
    };

    /*
     * Components that write their own labels hand the element back here instead
     * of translating it themselves. The recording's controls are the reason:
     * their text changes as it plays, and a component that rebuilt the tiers on
     * its own would be deciding what a screen reader hears, which is the one
     * thing this script keeps to itself.
     *
     * The caller has already written the English, so that is what gets recorded
     * as the original. A control the page never touched is not in `targets`
     * yet, and is added, or switching back to English would leave it behind.
     */
    const relabel = (node: HTMLElement): void => {
      if (!targets.includes(node)) targets.push(node);
      english.set(node, node.textContent ?? "");

      if (locale !== layerLocale) return;

      const text = catalog?.[catalogKey(node)];
      if (text === undefined) return;

      build(node, text, layerLocale, text);
    };

    document.addEventListener(
      "endoretic:relabel",
      (event) => {
        const node = (event as CustomEvent<{ node?: unknown }>).detail?.node;
        if (node instanceof HTMLElement) relabel(node);
      },
      { signal },
    );

    /*
     * Sections that only exist inside the layer — the homage on /credits is the
     * one so far. They ship in the markup and stay hidden, so they are part of
     * the page rather than something injected by script.
     */
    const layerOnly = Array.from(
      document.querySelectorAll<HTMLElement>("[data-layer-only]"),
    );

    const revealLayerOnly = (on: boolean): void => {
      for (const section of layerOnly) section.hidden = !on;
    };

    /*
     * The decode. Text corrupts in the interface face, flips to glyphs at the
     * halfway mark, then settles into Hymmnos: a signal resolving rather than a
     * string being swapped. Reduced motion skips straight to the settled state.
     */
    const BLOCKS = "█▓▒░";
    const LETTERS = "abcdefghijklmnopqrstuvwxyz";
    const DURATION = 620;
    const STAGGER = 14;
    const MAX_STAGGER_STEPS = 40;
    const FLIP = 0.42;

    const pick = (source: string): string =>
      source[Math.floor(Math.random() * source.length)] ?? "";

    const scramble = (text: string, settled: number, source: string): string => {
      let output = "";
      for (let index = 0; index < text.length; index += 1) {
        const character = text[index] ?? "";
        output +=
          index < settled || character === " " ? character : pick(source);
      }
      return output;
    };

    const settle = (entries: DecodeEntry[]): void => {
      for (const entry of entries) {
        if (entry.glyphs) renderHymmnos(entry.line, entry.to);
        else entry.line.textContent = entry.to;
        entry.line.lang = entry.glyphs ? layerLocale : "en";
        entry.line.removeAttribute("data-decoding");
      }
    };

    const decode = (entries: DecodeEntry[]): void => {
      window.cancelAnimationFrame(animation);
      if (entries.length === 0) return;

      if (reduceMotion.matches) {
        settle(entries);
        return;
      }

      for (const entry of entries) entry.line.setAttribute("data-decoding", "");

      const started = performance.now();
      const last = STAGGER * Math.min(entries.length, MAX_STAGGER_STEPS);

      const step = (now: number): void => {
        const elapsed = now - started;

        entries.forEach((entry, index) => {
          const progress = Math.min(
            1,
            Math.max(
              0,
              (elapsed - STAGGER * Math.min(index, MAX_STAGGER_STEPS)) /
                DURATION,
            ),
          );

          if (progress <= 0) return;

          if (progress >= 1) {
            if (entry.line.hasAttribute("data-decoding")) settle([entry]);
            return;
          }

          if (progress < FLIP) {
            /* Phase one: the departing language breaks up, in its own face. */
            entry.line.lang = entry.glyphs ? "en" : layerLocale;
            entry.line.textContent = scramble(
              entry.from,
              Math.round(entry.from.length * (1 - progress / FLIP)),
              BLOCKS,
            );
          } else {
            /*
             * Phase two: the arriving language resolves. Unsettled characters
             * are random letters, which the glyph font draws as glyphs, so the
             * noise is already in the destination script.
             */
            entry.line.lang = entry.glyphs ? layerLocale : "en";
            entry.line.textContent = scramble(
              entry.text,
              Math.round(entry.text.length * ((progress - FLIP) / (1 - FLIP))),
              LETTERS,
            );
          }
        });

        if (elapsed < last + DURATION) {
          animation = window.requestAnimationFrame(step);
        } else {
          settle(entries);
        }
      };

      animation = window.requestAnimationFrame(step);
    };

    const markOptions = (): void => {
      for (const option of panel.querySelectorAll<HTMLButtonElement>(
        "[data-language-option]",
      )) {
        const selected = option.dataset.languageOption === locale;
        option.setAttribute("aria-pressed", String(selected));
        const bullet = option.querySelector(".language-layer__bullet");
        if (bullet) bullet.textContent = selected ? "●" : "○";
      }
    };

    const toLayer = async (animate: boolean, current: number): Promise<void> => {
      if (!catalog) {
        try {
          const response = await fetch(catalogUrl);
          if (!response.ok) throw new Error(String(response.status));
          catalog = (await response.json()) as Record<string, string>;
        } catch {
          /* No catalog, no layer. The page is already correct in English. */
          if (signal.aborted || current !== request) return;
          requestedLocale = locale;
          markOptions();
          return;
        }
      }

      if (signal.aborted || current !== request) return;

      /*
        * A pending restore from a half-finished switch back would otherwise
        * fire mid-decode and tear the tiers down again.
        */
      window.clearTimeout(restoreTimer);

      const entries: DecodeEntry[] = [];
      for (const node of targets) {
        const text = catalog[catalogKey(node)];
        if (text === undefined) continue;
        const from = english.get(node) ?? "";
        /*
          * While animating, the line opens on the departing English and must be
          * marked as English, or the first frame draws Latin words in glyphs.
          */
        const line = animate
          ? build(node, from, defaultLocale, text)
          : build(node, text, layerLocale, text);
        if (animate) entries.push({ line, from, to: text, text: hymmnosTranscription(text), glyphs: true });
      }

      locale = layerLocale;
      document.documentElement.dataset.languageLayer = layerLocale;
      revealLayerOnly(true);
      decode(entries);
    };

    const toDefault = (animate: boolean): void => {
      const entries: DecodeEntry[] = [];

      if (animate && !reduceMotion.matches) {
        for (const node of targets) {
          const line = node.querySelector<HTMLElement>(".hy-line");
          const to = english.get(node) ?? "";
          if (!line) continue;
          entries.push({
            line,
            from: line.textContent ?? "",
            to,
            text: to,
            glyphs: false,
          });
        }
      }

      locale = defaultLocale;
      delete document.documentElement.dataset.languageLayer;
      revealLayerOnly(false);

      window.clearTimeout(restoreTimer);

      if (entries.length > 0) {
        decode(entries);
        /* The tiers come down only once the English has finished resolving. */
        restoreTimer = window.setTimeout(
          restore,
          DURATION + STAGGER * MAX_STAGGER_STEPS + 120,
        );
      } else {
        window.cancelAnimationFrame(animation);
        restore();
      }
    };

    const apply = async (next: string, animate: boolean): Promise<void> => {
      requestedLocale = next;
      const current = ++request;
      if (next === layerLocale) {
        await toLayer(animate, current);
      } else {
        toDefault(animate);
      }

      if (signal.aborted || current !== request) return;
      activeLayer = locale === layerLocale ? layerLocale : null;
      markOptions();
    };

    const openPanel = (open: boolean): void => {
      panel.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
      if (open) {
        panel
          .querySelector<HTMLButtonElement>('[aria-pressed="true"]')
          ?.focus();
      }
    };

    panel
      .querySelector<HTMLButtonElement>("[data-language-close]")
      ?.addEventListener(
        "click",
        () => {
          openPanel(false);
          trigger.focus();
        },
        { signal },
      );

    trigger.addEventListener(
      "click",
      () => {
        /* `hidden` is `string | boolean` since `until-found`; only openness matters. */
        openPanel(Boolean(panel.hidden));
      },
      { signal },
    );

    for (const option of panel.querySelectorAll<HTMLButtonElement>(
      "[data-language-option]",
    )) {
      option.addEventListener(
        "click",
        () => {
          const next = option.dataset.languageOption ?? defaultLocale;
          if (next !== requestedLocale) void apply(next, true);
        },
        { signal },
      );
    }

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && !panel.hidden) {
          openPanel(false);
          trigger.focus();
        }
      },
      { signal },
    );

    document.addEventListener(
      "click",
      (event) => {
        const target = event.target;
        if (!panel.hidden && target instanceof Node && !root.contains(target)) {
          openPanel(false);
        }
      },
      { signal },
    );

    /*
     * The switch only exists for readers whose browser ran this. Without it the
     * footer keeps an ordinary decorative mark and the site is unchanged.
     */
    root.hidden = false;

    const requested = new URLSearchParams(window.location.search).get(
      localeParam,
    );
    const asked =
      requested === "hymmnos" || requested === layerLocale
        ? layerLocale
        : requested !== null
          ? defaultLocale
          : null;
    if (asked === layerLocale || (asked === null && activeLayer === layerLocale)) {
      /*
       * An in-visit navigation keeps the settled layer without another reveal;
       * an explicit link can still request the easter egg directly.
       */
      void apply(layerLocale, asked !== null);
    } else {
      void apply(defaultLocale, false);
    }
  };

  /*
   * Two triggers, one run per page.
   *
   * The router fires astro:page-load on the window `load` event, which is after
   * every image and stylesheet has settled. Set up the first page immediately
   * so the switch and explicit easter-egg links need not wait for every image.
   * Module scripts are deferred, so the footer is already parsed.
   *
   * astro:page-load then covers every page reached by navigating, since the
   * router leaves this module loaded and nothing else would rebind the switch
   * to the new markup. The token keeps the two from both firing on the first
   * page, where a second run would restart a decode already in progress.
   */
  let pending = true;

  const run = (): void => {
    if (!pending) return;
    pending = false;
    setup();
  };

  run();

  document.addEventListener("astro:page-load", run);

  /*
   * The router copies the incoming document's root attributes over the live
   * ones, which drops the flag that selects the glyph face. Putting it back
   * here, before the frame is painted rather than in `setup` after it, is what
   * keeps a switched reader from seeing one frame of Latin on every navigation.
   */
  document.addEventListener("astro:after-swap", () => {
    pending = true;

    if (activeLayer) {
      document.documentElement.dataset.languageLayer = activeLayer;
    }
  });
</script>
