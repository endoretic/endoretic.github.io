---
import LicensedVideo from "./LicensedVideo.astro";
import { getAsset } from "../lib/assets";

const heroAsset = getAsset("hero-radio-array-01", "video");
---

<figure class="hero-media">
  <div class="hero-media__plate">
    <LicensedVideo
      assetId="hero-radio-array-01"
      posterAssetId="hero-radio-array-01-poster"
      posterAlt="A line of wire-frame radio telescope dishes crosses a misty grassland beneath a low sun."
      width={1280}
      height={720}
      sizes="(min-width: 64rem) 58vw, (min-width: 52rem) 52vw, 100vw"
      showAttribution={false}
    />
    <span class="hero-media__coordinate hero-media__coordinate--start" aria-hidden="true">
      00.00
    </span>
    <span class="hero-media__coordinate hero-media__coordinate--end" aria-hidden="true">
      11.22
    </span>
  </div>
  <figcaption>
    <span>
      <strong>Signal 00</strong> / {heroAsset.attribution}
      {" · "}<a href={heroAsset.source_page}>Source</a>
    </span>
    <span>Motion: desktop only · poster otherwise</span>
  </figcaption>
</figure>
