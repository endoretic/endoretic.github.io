---
import SceneVignette, { type SceneVariant } from "./SceneVignette.astro";
import { key, t, type MessageKey } from "../lib/i18n";

interface Props {
  index: string;
  titleKey: MessageKey;
  descriptionKey?: MessageKey;
  scene: SceneVariant;
}

const { index, titleKey, descriptionKey, scene } = Astro.props;
---

<header class:list={["page-header", "page-header--scene", `page-header--${scene}`]}>
  <div class="page-header__scene" aria-hidden="true">
    <SceneVignette
      variant={scene}
      class="page-header__vignette"
      sizes="(min-width: 64rem) 58vw, (min-width: 38rem) 64vw, 52vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="page-header__copy">
    {/* The register numeral is a mark, not a word: it never translates. */}
    <p class="eyebrow">{index} / <span {...key(titleKey)}>{t(titleKey)}</span></p>
    <h1 {...key(titleKey)}>{t(titleKey)}</h1>
    {
      descriptionKey && (
        <p class="lede" data-i18n-flow {...key(descriptionKey)}>
          {t(descriptionKey)}
        </p>
      )
    }
  </div>
</header>
