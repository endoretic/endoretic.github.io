---
import type { CollectionEntry } from "astro:content";
import { formatHtmlDate, formatIsoWeekDate } from "../lib/date";
import NotationMotif from "./NotationMotif.astro";
import { key, t } from "../lib/i18n";

interface Props {
  note: CollectionEntry<"notes">;
  headingLevel?: "h2" | "h3";
}

const { note, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const noteHref = "/notes/" + note.id + "/";
const publicationDate = note.data.publishedAt;
const formattedDate = publicationDate
  ? formatIsoWeekDate(publicationDate)
  : null;
const recordId = "N / " + note.id.toUpperCase();
---

<article class="note-card" lang={note.data.lang}>
  <div class="note-card__meta">
    <p class="eyebrow">
      <NotationMotif seed={note.id} class="notation-motif--inline" />{recordId}
    </p>
    <dl>
      <div>
        <dt {...key("field.language")}>{t("field.language")}</dt>
        {/* The tag itself is an identifier and stays as written. */}
        <dd>{note.data.lang}</dd>
      </div>
      {note.data.draft && (
        <div>
          <dt {...key("field.state")}>{t("field.state")}</dt>
          <dd {...key("state.draft")}>{t("state.draft")}</dd>
        </div>
      )}
      {formattedDate && (
        <div>
          <dt {...key("field.date")}>{t("field.date")}</dt>
          <dd><time datetime={formatHtmlDate(publicationDate!)}>{formattedDate}</time></dd>
        </div>
      )}
      {note.data.tags.length > 0 && (
        <div>
          <dt {...key("field.tags")}>{t("field.tags")}</dt>
          <dd>{note.data.tags.join(", ")}</dd>
        </div>
      )}
    </dl>
  </div>
  <div class="note-card__copy">
    <Heading>
      <a href={noteHref}>{note.data.title}</a>
    </Heading>
    <p>{note.data.description}</p>
  </div>
  <a class="text-link" href={noteHref}>
    <span {...key("record.read")}>{t("record.read")}</span>{" "}
    <span aria-hidden="true">→</span>
  </a>
</article>
