---
import AmbientAudio from "./AmbientAudio.astro";
import LanguageLayer from "./LanguageLayer.astro";
import { SITE } from "../data/site";
import { key, t } from "../lib/i18n";
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div class="site-footer__identity">
      {/*
        * Containers, not a paragraph. The language layer is a button and a
        * popover panel, so it carries real block content — a list of options
        * and two lines of text. Inside a <p> the parser closed the paragraph
        * at the first of them and left the wordmark stranded outside its own
        * flex container, which is why the mark and the name stacked instead of
        * sitting on one line. This block is a label and a wordmark, never
        * prose, so nothing is lost by saying so.
        */}
      <div class="site-footer__identity-line">
        <span class="eyebrow" {...key("footer.node")}>{t("footer.node")}</span>
        <div class="site-footer__mark">
          {SITE.name}
          {/*
           * Punctuation, not content: it separates the wordmark from the glyph
           * so the two read as one lockup rather than as a name with something
           * stuck to it. Hidden from assistive technology, which would
           * otherwise announce a vertical bar between the site name and a
           * button that already has its own label.
           */}
          <span class="site-footer__rule" aria-hidden="true">|</span>
          {/*
           * The interval mark after the footer wordmark is also the way into
           * the language layer. It stays a decorative glyph to the eye; the
           * component wraps it in a labelled button so keyboard and assistive
           * technology are never shut out of the discovery.
           */}
          <LanguageLayer seed={SITE.name} />
        </div>
      </div>
      <p class="site-footer__note" {...key("footer.recording")}>
        {t("footer.recording")}
      </p>
    </div>
    <AmbientAudio
      assetId="ambient-into-the-mist-01"
      label={t("footer.audio")}
      labelKey="footer.audio"
      recordId="A / 02"
      duration="2:09"
      initialVolume={0.15}
      class="site-footer__audio"
      showAttribution={true}
    />
  </div>
</footer>
