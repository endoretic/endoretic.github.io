---
import AmbientAudio from "./AmbientAudio.astro";
import NotationMotif from "./NotationMotif.astro";
import { SITE } from "../data/site";
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div class="site-footer__identity">
      <p>
        <span class="eyebrow">Archive node</span>
        <span class="site-footer__mark"><NotationMotif /> {SITE.name}</span>
      </p>
      <p class="site-footer__note">
        One recording is kept here. It stays silent until you play it.
      </p>
    </div>
    <AmbientAudio
      assetId="ambient-cylinder-seven-01"
      label="Retained recording"
      recordId="A / 01"
      duration="8:52"
      initialVolume={0.15}
      class="site-footer__audio"
      showAttribution={true}
    />
  </div>
</footer>
