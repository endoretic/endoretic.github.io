---
export type RecordArtworkVariant = "monument" | "vessel" | "automaton";

interface Props {
  variant: RecordArtworkVariant;
  class?: string;
}

const { variant, class: className } = Astro.props;
const imageBase = `/media/generated/record-art-${variant}-01`;
const dimensions: Record<RecordArtworkVariant, { width: number; height: number }> = {
  monument: { width: 1023, height: 1537 },
  vessel: { width: 1334, height: 1179 },
  automaton: { width: 1024, height: 1536 },
};
const { width, height } = dimensions[variant];
---

<picture
  class:list={["record-artwork", `record-artwork--${variant}`, className]}
  aria-hidden="true"
>
  <source
    type="image/avif"
    srcset={`${imageBase}-640.avif 640w, ${imageBase}-1024.avif 1024w`}
    sizes="(min-width: 42rem) 32vw, 78vw"
  />
  <source
    type="image/webp"
    srcset={`${imageBase}-640.webp 640w, ${imageBase}-1024.webp 1024w`}
    sizes="(min-width: 42rem) 32vw, 78vw"
  />
  <img
    src={`${imageBase}-1024.webp`}
    alt=""
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    onerror="this.closest('picture').hidden=true"
  />
</picture>
