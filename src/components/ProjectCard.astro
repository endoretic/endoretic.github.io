---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const projectHref = "/works/" + project.id + "/";
const recordId = "W / " + project.id.toUpperCase();
const landscapeVariant = project.id === "zontex" ? "tower" : "causeway";
---

<article class="record-card" lang={project.data.lang}>
  <header class="record-card__registration">
    <p>{recordId}</p>
    {project.data.placeholder && <p>Record incomplete</p>}
  </header>
  <div class="record-card__body">
    <p class="eyebrow">Project</p>
    <Heading>
      <a href={projectHref}>{project.data.title}</a>
    </Heading>
    <p>{project.data.summary}</p>
    <dl class="record-card__meta">
      <div>
        <dt>Language</dt>
        <dd>{project.data.lang}</dd>
      </div>
      {project.data.status && (
        <div>
          <dt>Status</dt>
          <dd>{project.data.status}</dd>
        </div>
      )}
      {project.data.year && (
        <div>
          <dt>Year</dt>
          <dd>{project.data.year}</dd>
        </div>
      )}
      {project.data.tags.length > 0 && (
        <div>
          <dt>Tags</dt>
          <dd>{project.data.tags.join(", ")}</dd>
        </div>
      )}
    </dl>
    <div class="record-card__links">
      <a class="text-link" href={projectHref}>
        Open record <span aria-hidden="true">→</span>
      </a>
      {project.data.repo && <a href={project.data.repo}>Repository</a>}
      {project.data.demo && <a href={project.data.demo}>Demo</a>}
    </div>
  </div>
  <div class="record-card__diagram" data-variant={landscapeVariant} aria-hidden="true">
    <svg viewBox="0 0 560 150" focusable="false">
      <path class="record-card__sky" d="M0 0h560v150H0z" />
      <path class="record-card__horizon" d="M0 98c75-8 126 3 188-2 73-6 111-20 184-13 68 7 105 3 188-8v75H0z" />
      <path
        class="record-card__ruin"
        d={landscapeVariant === "tower"
          ? "M377 82h10V38h18v44h12v7h-40zM393 38l3-16 4 16M278 90h67l18-8h22"
          : "M155 91h220l20-9h88v8h-91l-20 8H155zM428 82V51h12v31M433 51l4-12 3 12"}
      />
      <path class="record-card__reflection" d="M300 108c46 3 82 1 126-4M341 118c33 2 61 0 95-3M125 127c89-4 167-3 235 1" />
    </svg>
    <span>Image pending / {project.id}</span>
  </div>
</article>
