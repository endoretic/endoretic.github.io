---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const projectHref = "/works/" + project.id + "/";
const recordId = "W / " + project.id.toUpperCase();
const diagramVariant = project.id === "zontex" ? "offset" : "return";
---

<article class="record-card" lang={project.data.lang}>
  <header class="record-card__registration">
    <p>{recordId}</p>
    {project.data.placeholder && <p>Record incomplete</p>}
  </header>
  <div class="record-card__body">
    <p class="eyebrow">Project</p>
    <Heading>
      <a href={projectHref}>{project.data.title}</a>
    </Heading>
    <p>{project.data.summary}</p>
    <dl class="record-card__meta">
      <div>
        <dt>Language</dt>
        <dd>{project.data.lang}</dd>
      </div>
      {project.data.status && (
        <div>
          <dt>Status</dt>
          <dd>{project.data.status}</dd>
        </div>
      )}
      {project.data.year && (
        <div>
          <dt>Year</dt>
          <dd>{project.data.year}</dd>
        </div>
      )}
      {project.data.tags.length > 0 && (
        <div>
          <dt>Tags</dt>
          <dd>{project.data.tags.join(", ")}</dd>
        </div>
      )}
    </dl>
    <div class="record-card__links">
      <a class="text-link" href={projectHref}>
        Open record <span aria-hidden="true">→</span>
      </a>
      {project.data.repo && <a href={project.data.repo}>Repository</a>}
      {project.data.demo && <a href={project.data.demo}>Demo</a>}
    </div>
  </div>
  <div class="record-card__diagram" data-variant={diagramVariant} aria-hidden="true">
    <svg viewBox="0 0 560 150" focusable="false">
      <path class="record-card__trace" d={diagramVariant === "offset" ? "M0 94h76c28 0 31-41 59-41s33 25 61 25 31-14 59-14 33 38 61 38 31-58 59-58 33 29 61 29 31-13 59-13 33 34 61 34h64" : "M0 82h92c24 0 31-30 55-30s31 46 55 46 31-21 55-21 31 9 55 9 31-44 55-44 31 60 55 60 31-31 55-31 31 11 55 11h52"} />
      <circle cx="150" cy="74" r="31" />
      <circle cx="403" cy="74" r="22" />
      <path d="M12 22h92M456 124h92M281 25v98" />
      <circle class="record-card__signal" cx="281" cy="74" r="4" />
    </svg>
    <span>Generated placeholder / {project.id}</span>
  </div>
</article>
