---
import type { CollectionEntry } from "astro:content";
import NotationMotif from "./NotationMotif.astro";
import RecordLocator from "./RecordLocator.astro";
import WorkSignal from "./WorkSignal.astro";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const projectHref = "/works/" + project.id + "/";
const recordId = "W / " + project.id.toUpperCase();
---

<article class="record-card" lang={project.data.lang}>
  <header class="record-card__registration">
    <p><NotationMotif seed={project.id} class="notation-motif--inline" />{recordId}</p>
    {project.data.placeholder && <p>Record incomplete</p>}
  </header>
  <div class="record-card__body">
    <p class="eyebrow">Project</p>
    <Heading>
      <a href={projectHref}>{project.data.title}</a>
    </Heading>
    <p>{project.data.summary}</p>
    <dl class="record-card__meta">
      <div>
        <dt>Language</dt>
        <dd>{project.data.lang}</dd>
      </div>
      {project.data.status && (
        <div>
          <dt>Status</dt>
          <dd>{project.data.status}</dd>
        </div>
      )}
      {project.data.year && (
        <div>
          <dt>Year</dt>
          <dd>{project.data.year}</dd>
        </div>
      )}
      {project.data.tags.length > 0 && (
        <div>
          <dt>Tags</dt>
          <dd>{project.data.tags.join(", ")}</dd>
        </div>
      )}
    </dl>
    <div class="record-card__links">
      <a class="text-link" href={projectHref}>
        Open record <span aria-hidden="true">→</span>
      </a>
      {project.data.repo && <a href={project.data.repo}>Repository</a>}
      {project.data.demo && <a href={project.data.demo}>Demo</a>}
    </div>
  </div>
  <WorkSignal seed={project.id} class="record-card__signal" />
  <RecordLocator
    href={projectHref}
    label={`Open ${project.data.title} record`}
    class="record-card__locator"
  />
</article>
