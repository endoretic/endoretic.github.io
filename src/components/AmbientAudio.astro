---
import { getAsset, getAudioSources } from "../lib/assets";
import { stableIndex } from "../lib/hash";
import { key, t, type MessageKey } from "../lib/i18n";

interface Props {
  assetId: string;
  label?: string;
  /*
   * Optional catalog entry for the visible label. The `aria-label` keeps the
   * English text either way: the language layer changes what is drawn, never
   * the accessible name of a media control.
   */
  labelKey?: MessageKey;
  initialVolume?: number;
  class?: string;
  showAttribution?: boolean;
  /* Archive register line. Presentational only; never the accessible name. */
  recordId?: string;
  /* Human-readable running time, e.g. "8:52". */
  duration?: string;
}

const {
  assetId,
  label = "Ambient audio",
  labelKey,
  initialVolume = 0.15,
  class: className,
  showAttribution = true,
  recordId,
  duration,
} = Astro.props;

if (initialVolume < 0 || initialVolume > 1) {
  throw new Error(`AmbientAudio ${assetId} initialVolume must be from 0 to 1.`);
}

const asset = getAsset(assetId, "audio");
const sources = getAudioSources(assetId);

/*
 * A static waveform, so the track reads as a retained recording rather than a
 * feature toggle. It is derived deterministically from the asset id: it is an
 * emblem of a stored signal, not an analysis of this file, and it is decorative
 * and marked aria-hidden. Drawing a real waveform would mean decoding the audio
 * at build time and shipping the peaks, which is a lot of machinery for a mark
 * nobody reads quantitatively. Nothing animates, so reduced-motion needs no
 * special case.
 */
const WAVE_BARS = 96;
const waveform = Array.from({ length: WAVE_BARS }, (_, index) => {
  const seed = stableIndex(`${assetId}:${index}`, 1000) / 1000;
  // Two slow envelopes so the shape swells and settles like a field recording
  // rather than sitting at a constant height.
  const envelope =
    0.42 +
    0.34 * Math.sin((index / WAVE_BARS) * Math.PI * 2.2) ** 2 +
    0.18 * Math.sin((index / WAVE_BARS) * Math.PI * 7.4) ** 2;
  return Math.max(0.06, Math.min(1, envelope * (0.55 + seed * 0.75)));
});
const settingsKey = `endoretic:audio:${assetId}:settings`;

/*
 * Every label the player can show, resolved from the catalog at build time.
 *
 * The controls rewrite their own text as the recording plays, so the strings
 * cannot live only in the markup. Shipping them as one table keeps the English
 * single-sourced from the catalog — the script never spells a label itself —
 * and lets the language layer translate a button the moment its state changes.
 */
const LABEL_KEYS = [
  "audio.enable",
  "audio.enabled",
  "audio.play",
  "audio.pause",
  "audio.mute",
  "audio.unmute",
  "audio.volume",
  "audio.status.off",
  "audio.status.starting",
  "audio.status.ready",
  "audio.status.playing",
  "audio.status.playingMuted",
  "audio.status.paused",
  "audio.status.hidden",
  "audio.status.finished",
  "audio.status.unavailable",
] as const satisfies readonly MessageKey[];

const labels = Object.fromEntries(LABEL_KEYS.map((id) => [id, t(id)]));
---

{/*
  * The one element on the site that must outlive a navigation. The router moves
  * this node into the next page rather than rebuilding it, so the audio element
  * is never torn down, playback is never interrupted, and the controls keep the
  * listeners they were given: the whole section persists, not just the <audio>,
  * because a persisted player under freshly rendered buttons would be playing
  * with nothing wired to it.
  */}
<section
  class:list={["ambient-audio", className]}
  aria-label={label}
  transition:persist="retained-recording"
  data-ambient-audio
  data-asset-id={assetId}
  data-sources={JSON.stringify(sources)}
  data-settings-key={settingsKey}
  data-initial-volume={initialVolume}
  data-labels={JSON.stringify(labels)}
>
  <div class="ambient-audio__heading">
    <span class="ambient-audio__label" {...(labelKey ? key(labelKey) : {})}>
      {label}
    </span>
    <span
      class="ambient-audio__status"
      data-audio-status
      role="status"
      {...key("audio.status.off")}>{t("audio.status.off")}</span>
  </div>

  <p class="ambient-audio__register">
    {recordId && <span>{recordId}</span>}
    <span>{asset.title}</span>
    {duration && <span>{duration}</span>}
  </p>

  <svg
    class="ambient-audio__waveform"
    viewBox={`0 0 ${WAVE_BARS * 3} 40`}
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
    data-audio-waveform
  >
    {
      waveform.map((height, index) => (
        <rect
          x={index * 3}
          y={20 - (height * 36) / 2}
          width="1.6"
          height={height * 36}
          rx="0.8"
        />
      ))
    }
  </svg>

  <audio preload="none" hidden></audio>

  <div class="ambient-audio__controls">
    <button type="button" data-audio-enable {...key("audio.enable")}>{t("audio.enable")}</button>
    <button type="button" data-audio-toggle aria-pressed="false" disabled {...key("audio.play")}>{t("audio.play")}</button>
    <button type="button" data-audio-mute aria-pressed="false" disabled {...key("audio.mute")}>{t("audio.mute")}</button>
    <label class="ambient-audio__volume">
      <span {...key("audio.volume")}>{t("audio.volume")}</span>
      <input
        type="range"
        min="0"
        max="1"
        step="0.05"
        value={initialVolume}
        data-audio-volume
        disabled
      />
    </label>
  </div>

  <noscript><p>This recording needs JavaScript to play. Everything else on the page works without it.</p></noscript>

  {
    showAttribution && (
      <small class="ambient-audio__attribution">
        <span>{asset.attribution}</span>{" "}
        <a href={asset.source_page}>Original source</a>{" · "}
        <a href={asset.license_url}>License</a>
      </small>
    )
  }
</section>

<script>
  interface LocalAudioSource {
    path: string;
    mimeType: string;
  }

  interface AudioSettings {
    muted: boolean;
    volume: number;
  }

  /*
   * Runs once per document. The section is persisted across navigations, so it
   * arrives on the next page already initialised and carrying its listeners,
   * and the flag below is what stops a second pass from binding them twice if
   * this module is ever evaluated again.
   */
  document
    .querySelectorAll<HTMLElement>("[data-ambient-audio]")
    .forEach((root) => {
      if (root.dataset.audioInitialized === "true") return;
      root.dataset.audioInitialized = "true";

      const audio = root.querySelector<HTMLAudioElement>("audio");
      const enable = root.querySelector<HTMLButtonElement>("[data-audio-enable]");
      const toggle = root.querySelector<HTMLButtonElement>("[data-audio-toggle]");
      const mute = root.querySelector<HTMLButtonElement>("[data-audio-mute]");
      const volume = root.querySelector<HTMLInputElement>("[data-audio-volume]");
      const status = root.querySelector<HTMLElement>("[data-audio-status]");
      const storageKey = root.dataset.settingsKey ?? "endoretic:audio:settings";
      const defaultVolume = Number(root.dataset.initialVolume ?? "0.15");
      let enabled = false;

      if (!audio || !enable || !toggle || !mute || !volume || !status) return;

      let labels: Record<string, string> = {};
      try {
        labels = JSON.parse(root.dataset.labels ?? "{}") as Record<string, string>;
      } catch {
        /* Without the table the controls keep the English already in the markup. */
      }

      /*
       * Every label change goes through here. The English from the catalog is
       * written first, so the page is correct even if no layer is active, and
       * the element is then handed to the language layer, which owns the
       * decision about what is drawn and what a screen reader is told. Nothing
       * in this component knows that Hymmnos exists.
       */
      const setLabel = (node: HTMLElement, id: string): void => {
        const text = labels[id];
        if (text === undefined) return;

        node.dataset.i18n = id;
        node.textContent = text;
        document.dispatchEvent(
          new CustomEvent("endoretic:relabel", { detail: { node } }),
        );
      };

      const readSettings = (): AudioSettings => {
        try {
          const saved = JSON.parse(localStorage.getItem(storageKey) ?? "null") as
            | Partial<AudioSettings>
            | null;
          return {
            muted: typeof saved?.muted === "boolean" ? saved.muted : false,
            volume:
              typeof saved?.volume === "number" &&
              saved.volume >= 0 &&
              saved.volume <= 1
                ? saved.volume
                : defaultVolume,
          };
        } catch {
          return { muted: false, volume: defaultVolume };
        }
      };

      const saveSettings = () => {
        try {
          localStorage.setItem(
            storageKey,
            JSON.stringify({ muted: audio.muted, volume: audio.volume }),
          );
        } catch {
          // Storage can be unavailable; playback controls continue to work.
        }
      };

      const applySettings = () => {
        const saved = readSettings();
        audio.muted = saved.muted;
        audio.volume = saved.volume;
        volume.value = String(saved.volume);
        setLabel(mute, saved.muted ? "audio.unmute" : "audio.mute");
        mute.setAttribute("aria-pressed", String(saved.muted));
      };

      const setUnavailable = () => {
        audio.pause();
        setLabel(status, "audio.status.unavailable");
        enable.disabled = true;
        toggle.disabled = true;
        mute.disabled = true;
        volume.disabled = true;
      };

      applySettings();

      enable.addEventListener("click", () => {
        if (enabled) return;

        let sources: LocalAudioSource[];
        try {
          sources = JSON.parse(root.dataset.sources ?? "[]") as LocalAudioSource[];
        } catch {
          setUnavailable();
          return;
        }

        if (sources.length === 0) {
          setUnavailable();
          return;
        }

        sources.forEach(({ path, mimeType }) => {
          const source = document.createElement("source");
          source.src = path;
          source.type = mimeType;
          audio.append(source);
        });
        audio.load();
        enabled = true;
        enable.disabled = true;
        setLabel(enable, "audio.enabled");
        toggle.disabled = false;
        mute.disabled = false;
        volume.disabled = false;
        setLabel(status, "audio.status.starting");

        void audio.play().catch(() => {
          setLabel(toggle, "audio.play");
          setLabel(status, "audio.status.ready");
        });
      });

      toggle.addEventListener("click", () => {
        if (!enabled) return;
        if (audio.paused) {
          void audio.play().catch(setUnavailable);
        } else {
          audio.pause();
        }
      });

      mute.addEventListener("click", () => {
        audio.muted = !audio.muted;
        setLabel(mute, audio.muted ? "audio.unmute" : "audio.mute");
        mute.setAttribute("aria-pressed", String(audio.muted));
        if (!audio.paused) {
          setLabel(
            status,
            audio.muted ? "audio.status.playingMuted" : "audio.status.playing",
          );
        }
        saveSettings();
      });

      volume.addEventListener("input", () => {
        audio.volume = Number(volume.value);
        saveSettings();
      });

      audio.addEventListener("play", () => {
        setLabel(toggle, "audio.pause");
        toggle.setAttribute("aria-pressed", "true");
        setLabel(
          status,
          audio.muted ? "audio.status.playingMuted" : "audio.status.playing",
        );
      });
      audio.addEventListener("pause", () => {
        setLabel(toggle, "audio.play");
        toggle.setAttribute("aria-pressed", "false");
        if (enabled && !audio.ended) setLabel(status, "audio.status.paused");
      });
      audio.addEventListener("ended", () => {
        setLabel(toggle, "audio.play");
        toggle.setAttribute("aria-pressed", "false");
        setLabel(status, "audio.status.finished");
      });
      audio.addEventListener("error", setUnavailable, { once: true });

      document.addEventListener("visibilitychange", () => {
        if (document.hidden && !audio.paused) {
          audio.pause();
          setLabel(status, "audio.status.hidden");
        }
      });
    });
</script>

<style>
  .ambient-audio {
    display: grid;
    gap: var(--space-3, 1rem);
    padding: var(--space-4, 1.5rem);
    border: 1px solid var(--line-strong, rgb(48 49 44 / 0.48));
    background: rgb(233 228 207 / 0.46);
  }

  .ambient-audio__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2, 0.75rem);
  }

  .ambient-audio__label,
  .ambient-audio__status,
  .ambient-audio__volume,
  .ambient-audio__attribution {
    font-family: var(--font-meta, monospace);
    font-size: var(--type-meta, 0.75rem);
  }

  .ambient-audio__label {
    color: var(--ink-950, #292a26);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ambient-audio__status,
  .ambient-audio__attribution {
    color: var(--ink-500, #66685f);
  }

  .ambient-audio__register {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1, 0.375rem) var(--space-3, 1rem);
    margin: 0;
    color: var(--ink-500, #66685f);
    font-family: var(--font-meta, monospace);
    font-size: var(--type-meta, 0.75rem);
    letter-spacing: 0.04em;
  }

  .ambient-audio__register span:nth-child(2) {
    color: var(--ink-950, #292a26);
  }

  .ambient-audio__waveform {
    width: 100%;
    height: 2.6rem;
    fill: var(--cold-500, #6d7b75);
    opacity: 0.66;
  }

  .ambient-audio__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2, 0.75rem);
  }

  .ambient-audio button {
    min-height: 2.75rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line-strong, rgb(48 49 44 / 0.48));
    color: var(--ink-950, #292a26);
    background: var(--surface-1, #e9e4cf);
    font: inherit;
    cursor: pointer;
  }

  .ambient-audio button:disabled {
    color: var(--ink-500, #66685f);
    cursor: default;
    opacity: 0.7;
  }

  .ambient-audio__volume {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2, 0.75rem);
    padding-inline: 0.3rem;
  }

  .ambient-audio__volume input {
    width: min(10rem, 30vw);
    accent-color: var(--signal-500, #865247);
  }

  .ambient-audio noscript p {
    color: var(--ink-500, #66685f);
    font-size: var(--type-meta, 0.75rem);
  }

  @media (max-width: 38rem) {
    .ambient-audio__controls {
      align-items: stretch;
    }

    .ambient-audio button {
      flex: 1 1 calc(50% - var(--space-2, 0.75rem));
    }

    .ambient-audio__volume {
      width: 100%;
      justify-content: space-between;
    }

    .ambient-audio__volume input {
      width: min(13rem, 56vw);
    }
  }
</style>
