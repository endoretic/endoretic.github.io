---
import NoteCard from "../../components/NoteCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getVisibleNotes } from "../../lib/content";

const notes = await getVisibleNotes();
---

<BaseLayout
  title="Notes"
  description="Essays and notes in the endoretic archive."
>
  <div class="shell page-shell">
    <header class="page-header">
      <p class="eyebrow">02 / Notes</p>
      <h1>Notes</h1>
      <p class="lede">
        Essays, observations, and technical notes.
      </p>
    </header>

    {
      notes.length > 0 ? (
        <div class="note-list">
          {notes.map((note) => <NoteCard note={note} />)}
        </div>
      ) : (
        <p class="empty-state">Nothing published here yet.</p>
      )
    }
  </div>
</BaseLayout>
