---
import NoteCard from "../../components/NoteCard.astro";
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getVisibleNotes } from "../../lib/content";
import { key, t } from "../../lib/i18n";

const notes = await getVisibleNotes();
---

<BaseLayout
  title="Notes"
  description="Essays and notes in the endoretic archive."
>
  <div class="shell page-shell">
    <PageHero
      index="02"
      titleKey="notes.title"
      descriptionKey="notes.description"
      scene="hall"
    />

    {
      notes.length > 0 ? (
        <div class="note-list">
          {notes.map((note) => <NoteCard note={note} />)}
        </div>
      ) : (
        <p class="empty-state" {...key("common.empty")}>
          {t("common.empty")}
        </p>
      )
    }
  </div>
</BaseLayout>
