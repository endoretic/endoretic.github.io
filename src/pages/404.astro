---
import BaseLayout from "../layouts/BaseLayout.astro";
import NotationMotif from "../components/NotationMotif.astro";
import SceneVignette from "../components/SceneVignette.astro";
import { key, t } from "../lib/i18n";
---

<BaseLayout
  title="Signal not found"
  description="The requested page is not present in this archive."
  indexable={false}
  shareable={false}
>
  <div class="shell not-found">
    <SceneVignette variant="coast" class="not-found__scene" sizes="100vw" />
    <span class="not-found__register" aria-hidden="true">404</span>
    <div class="not-found__copy">
      <NotationMotif />
      <p class="eyebrow">
        404 / <span {...key("notfound.eyebrow")}>{t("notfound.eyebrow")}</span>
      </p>
      <h1 {...key("notfound.title")}>{t("notfound.title")}</h1>
      <p data-i18n-flow {...key("notfound.body")}>{t("notfound.body")}</p>
      <a class="text-link" href="/">
        <span {...key("notfound.home")}>{t("notfound.home")}</span>{" "}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</BaseLayout>
