---
import BaseLayout from "../layouts/BaseLayout.astro";
import NotationMotif from "../components/NotationMotif.astro";
import SceneVignette from "../components/SceneVignette.astro";
---

<BaseLayout
  title="Signal not found"
  description="The requested page is not present in this archive."
  indexable={false}
  shareable={false}
>
  <div class="shell not-found">
    <SceneVignette variant="coast" class="not-found__scene" />
    <span class="not-found__register" aria-hidden="true">404</span>
    <div class="not-found__copy">
      <NotationMotif />
      <p class="eyebrow">404 / Missing record</p>
      <h1>Signal not found</h1>
      <p>The requested record is absent from this archive.</p>
      <a class="text-link" href="/">
        Return home <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</BaseLayout>
