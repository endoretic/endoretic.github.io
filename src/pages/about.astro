---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { key, t } from "../lib/i18n";
---

<BaseLayout
  title="About"
  description="Who keeps this archive, what it is for, and why it looks the way it does."
>
  <div class="shell page-shell page-shell--narrow">
    <PageHero
      index="03"
      titleKey="about.title"
      descriptionKey="about.description"
      scene="console"
    />

    <div class="about-page">
      <section class="about-introduction" aria-labelledby="about-keeper">
        <div class="about-introduction__copy">
          <h2 id="about-keeper" {...key("about.keeper.title")}>
            {t("about.keeper.title")}
          </h2>
          <p class="about-lede" data-i18n-flow {...key("about.keeper.lede")}>
            {t("about.keeper.lede")}
          </p>
        </div>

        <aside class="about-index" aria-labelledby="about-interests">
          <h3 id="about-interests" {...key("about.interests.title")}>
            {t("about.interests.title")}
          </h3>
          <ul>
            <li {...key("about.interests.animation")}>
              {t("about.interests.animation")}
            </li>
            <li {...key("about.interests.novels")}>
              {t("about.interests.novels")}
            </li>
            <li {...key("about.interests.music")}>
              {t("about.interests.music")}
            </li>
            <li {...key("about.interests.games")}>
              {t("about.interests.games")}
            </li>
          </ul>
        </aside>
      </section>

      <section class="about-origin" aria-labelledby="about-origin">
        <div class="about-section-heading">
          <h2 id="about-origin" {...key("about.origin.title")}>
            {t("about.origin.title")}
          </h2>
        </div>
        <div class="about-section-copy">
          <p
            class="about-origin__statement"
            data-i18n-flow
            {...key("about.origin.statement")}
          >
            {t("about.origin.statement")}
          </p>
          <p data-i18n-flow {...key("about.origin.body")}>
            {t("about.origin.body")}
          </p>
          <div class="about-memory-fragments">
            <p
              class="about-memory-fragments__label"
              {...key("about.fragments.label")}
            >
              {t("about.fragments.label")}
            </p>
            <p data-i18n-flow {...key("about.fragments.body")}>
              {t("about.fragments.body")}
            </p>
          </div>
        </div>
      </section>

      <div class="about-closing">
        <section class="about-purpose" aria-labelledby="about-purpose">
          <h2 id="about-purpose" {...key("about.purpose.title")}>
            {t("about.purpose.title")}
          </h2>
          <p data-i18n-flow {...key("about.purpose.body")}>
            {t("about.purpose.body")}
          </p>
        </section>

        <section class="about-elsewhere" aria-labelledby="about-elsewhere">
          <h2 id="about-elsewhere" {...key("about.elsewhere.title")}>
            {t("about.elsewhere.title")}
          </h2>
          {/*
            * Service names, handles, and addresses stay exactly as they are in
            * every layer. They are identifiers, not prose.
            */}
          <ul>
            <li>
              <span>GitHub</span>
              <a href="https://github.com/endoretic">endoretic</a>
            </li>
            <li>
              <span>Bilibili</span>
              <a
                href="https://b23.tv/dYV8t7Q"
                {...key("about.elsewhere.profile")}
              >
                {t("about.elsewhere.profile")}
              </a>
            </li>
            <li>
              <span>LinkedIn</span>
              <a
                href="https://www.linkedin.com/in/yukun-bian-a15639387/"
                {...key("about.elsewhere.profile")}
              >
                {t("about.elsewhere.profile")}
              </a>
            </li>
            <li>
              <span>Email</span>
              <a href="mailto:pawn0319@gmail.com">pawn0319@gmail.com</a>
            </li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
