---
import HeroMedia from "../components/HeroMedia.astro";
import NoteCard from "../components/NoteCard.astro";
import NotationMotif from "../components/NotationMotif.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SceneVignette from "../components/SceneVignette.astro";
import { SITE } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVisibleNotes, getVisibleProjects } from "../lib/content";

const projects = await getVisibleProjects();
const notes = await getVisibleNotes();
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <div class="hero__index-line">
          <p class="eyebrow">00 / Home · Personal archive</p>
          <NotationMotif />
        </div>
        <h1>ENDORETIC</h1>
        <p class="hero__lede">{SITE.description}</p>
        <a class="text-link" href="/works/">
          Browse works <span aria-hidden="true">→</span>
        </a>
      </div>
      <HeroMedia />
    </div>
  </section>

  <section class="section shell identity-section" aria-labelledby="identity-title">
    <div class="identity-section__heading">
      <p class="eyebrow">H.01 / Introduction</p>
      <h2 id="identity-title">About this archive</h2>
    </div>
    <div class="pending-copy">
      <p>
        A personal archive of research tooling, small utilities, notes, and
        unfinished systems. Most of it is open source.
      </p>
      <a class="text-link" href="/about/">
        About <span aria-hidden="true">→</span>
      </a>
    </div>
    <SceneVignette variant="hall" class="identity-section__scene" />
  </section>

  <section class="section shell" aria-labelledby="works-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">H.02 / Works · initial records</p>
        <h2 id="works-title">Works</h2>
      </div>
      <a class="text-link" href="/works/">View all works</a>
    </div>
    <div class="card-grid">
      {
        projects.map((project) => (
          <ProjectCard project={project} headingLevel="h3" />
        ))
      }
    </div>
  </section>

  <section class="section shell" aria-labelledby="notes-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">H.03 / Notes · recent records</p>
        <h2 id="notes-title">Notes</h2>
      </div>
      <a class="text-link" href="/notes/">View notes</a>
    </div>
    {
      notes.length > 0 ? (
        <div class="note-list">
          {notes.slice(0, 3).map((note) => (
            <NoteCard note={note} headingLevel="h3" />
          ))}
        </div>
      ) : (
        <p class="empty-state">Nothing published here yet.</p>
      )
    }
  </section>

</BaseLayout>
