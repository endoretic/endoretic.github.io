---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import NotationMotif from "../components/NotationMotif.astro";
import { key, t } from "../lib/i18n";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const metadataDescription = data.placeholder
  ? "Project record is being assembled."
  : data.summary;
---

<BaseLayout title={data.title} description={metadataDescription} lang={data.lang}>
  <div class="shell page-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/works/" {...key("breadcrumb.works")}>{t("breadcrumb.works")}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{data.title}</span>
    </nav>

    <article class="record-page">
      <div class="record-page__registration">
        <span>
          <NotationMotif seed={project.id} class="notation-motif--inline" />W / {
            project.id.toUpperCase()
          }
        </span>
        <span>{data.lang}</span>
      </div>
      <header class="record-page__header">
        <p class="eyebrow">
          <span {...key("record.projectRecord")}>{t("record.projectRecord")}</span>
          {data.placeholder && (
            <span>
              {" / "}
              <span {...key("record.detailsPending")}>
                {t("record.detailsPending")}
              </span>
            </span>
          )}
        </p>
        <h1>{data.title}</h1>
        <p class="lede">{data.summary}</p>

        <dl class="record-metadata">
          {/* Values are identifiers, dates, and numbers: labels translate, data does not. */}
          <dt {...key("field.language")}>{t("field.language")}</dt>
          <dd>{data.lang}</dd>
          {data.placeholder && (
            <>
              <dt {...key("field.state")}>{t("field.state")}</dt>
              <dd {...key("state.incomplete")}>{t("state.incomplete")}</dd>
            </>
          )}
          {data.status && (
            <>
              <dt {...key("field.status")}>{t("field.status")}</dt>
              <dd>{data.status}</dd>
            </>
          )}
          {data.year && (
            <>
              <dt {...key("field.year")}>{t("field.year")}</dt>
              <dd>{data.year}</dd>
            </>
          )}
          {data.tags.length > 0 && (
            <>
              <dt {...key("field.tags")}>{t("field.tags")}</dt>
              <dd>{data.tags.join(", ")}</dd>
            </>
          )}
        </dl>
      </header>

      <div class="prose">
        <slot />
      </div>

      {
        (data.repo || data.demo) && (
          <footer class="record-page__links">
            {data.repo && (
              <a href={data.repo} {...key("record.repo")}>
                {t("record.repo")}
              </a>
            )}
            {data.demo && (
              <a href={data.demo} {...key("record.demo")}>
                {t("record.demo")}
              </a>
            )}
          </footer>
        )
      }
    </article>
  </div>
</BaseLayout>
