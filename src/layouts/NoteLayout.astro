---
import type { CollectionEntry } from "astro:content";
import { formatHtmlDate, formatIsoWeekDate } from "../lib/date";
import BaseLayout from "./BaseLayout.astro";
import { key, t } from "../lib/i18n";

interface Props {
  note: CollectionEntry<"notes">;
}

const { note } = Astro.props;
const { data } = note;
const lastUpdated = data.updatedAt;
const formattedDate = lastUpdated ? formatIsoWeekDate(lastUpdated) : null;
const recordId = "N / " + note.id.toUpperCase();
---

<BaseLayout title={data.title} description={data.description} lang={data.lang}>
  <div class="shell page-shell page-shell--narrow note-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/notes/" {...key("breadcrumb.notes")}>{t("breadcrumb.notes")}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{data.title}</span>
    </nav>

    <article class:list={["note-page", "note-page--" + data.readingMode]}>
      <div class="note-page__registration">
        <span>{recordId}</span>
        <span>{data.lang}</span>
      </div>
      <header class="note-page__header">
        <p class="eyebrow">
          <span {...key("record.note")}>{t("record.note")}</span>
          {data.draft && (
            <span>
              {" / "}
              <span {...key("record.draftPreview")}>
                {t("record.draftPreview")}
              </span>
            </span>
          )}
        </p>
        <h1>{data.title}</h1>
        {data.fictionalized && (
          <p class="note-page__fiction-notice">
            本文含虚构整理与想象性叙述，不代表实际情况。
          </p>
        )}
        <p class="lede">{data.description}</p>
        <dl class="note-page__metadata">
          <div>
            <dt {...key("field.state")}>{t("field.state")}</dt>
            {data.draft ? (
              <dd {...key("state.draft")}>{t("state.draft")}</dd>
            ) : (
              <dd {...key("state.archived")}>{t("state.archived")}</dd>
            )}
          </div>
          {formattedDate && (
            <div>
              <dt {...key("field.lastUpdated")}>{t("field.lastUpdated")}</dt>
              <dd><time datetime={formatHtmlDate(lastUpdated!)}>{formattedDate}</time></dd>
            </div>
          )}
          {data.tags.length > 0 && (
            <div>
              <dt {...key("field.tags")}>{t("field.tags")}</dt>
              <dd>{data.tags.join(", ")}</dd>
            </div>
          )}
        </dl>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
