---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  note: CollectionEntry<"notes">;
}

const { note } = Astro.props;
const { data } = note;
const formattedDate = data.publishedAt
  ? new Intl.DateTimeFormat(data.lang, {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    }).format(data.publishedAt)
  : null;
const recordId = "N / " + note.id.toUpperCase();
---

<BaseLayout title={data.title} description={data.description} lang={data.lang}>
  <div class="shell page-shell note-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/notes/">Notes</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{data.title}</span>
    </nav>

    <article class:list={["note-page", "note-page--" + data.readingMode]}>
      <div class="note-page__registration">
        <span>{recordId}</span>
        <span>{data.lang}</span>
      </div>
      <header class="note-page__header">
        <p class="eyebrow">
          Note
          {data.draft && <span> / local draft preview</span>}
        </p>
        <h1>{data.title}</h1>
        {data.fictionalized && (
          <p class="note-page__fiction-notice">
            虚实结合：本文以真实影像为基础，含虚构整理与想象性叙述，不代表实际情况。
          </p>
        )}
        <p class="lede">{data.description}</p>
        <dl class="note-page__metadata">
          <div>
            <dt>Record state</dt>
            <dd>{data.draft ? "Draft preview" : "Published"}</dd>
          </div>
          {formattedDate && (
            <div>
              <dt>Published</dt>
              <dd><time datetime={data.publishedAt?.toISOString()}>{formattedDate}</time></dd>
            </div>
          )}
          {data.tags.length > 0 && (
            <div>
              <dt>Tags</dt>
              <dd>{data.tags.join(", ")}</dd>
            </div>
          )}
        </dl>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
